# --- Servidor ---
# Render inyecta PORT automáticamente. En local usar 4000.
PORT=4000
# development | production
NODE_ENV=development

# --- MongoDB (Atlas) ---
# Cadena de conexión completa. Contiene credenciales: el .env real NO se versiona.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/<base>?retryWrites=true&w=majority
# Alternativa por partes (por si se prefiere construir la URI desde acá).
MONGODB_USERNAME=
MONGODB_PASSWORD=

# --- CORS ---
# "*" en desarrollo. En producción: lista de orígenes separados por coma.
CORS_ORIGIN=*
